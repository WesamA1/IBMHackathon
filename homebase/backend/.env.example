DATABASE_URL=sqlite:///./homebase.db
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,null

# ── AI provider for notes → flashcards generation ─────────────────────────
# Choose ONE (or more — they are tried in order: Ollama → Groq → watsonx)

# Option 1 — Ollama (FREE, fully local, no account needed)
#   1. Install Ollama: https://ollama.com
#   2. Run: ollama pull granite3-moe:1b
#   The app will detect Ollama automatically — nothing to set here.
OLLAMA_MODEL=granite3-moe:1b

# Option 2 — Groq (FREE cloud tier, no credit card)
#   Sign up at https://console.groq.com → API Keys → Create key
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Option 3 — IBM watsonx.ai (paid IBM Cloud account)
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_MODEL=ibm/granite-3-8b-instruct
